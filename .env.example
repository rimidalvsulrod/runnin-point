# Database from Neon or another serverless Postgres provider
DATABASE_URL=postgresql://...

# Long random value used to sign the admin session cookie
SESSION_SECRET=replace-with-at-least-32-random-characters

# Initial artist/admin login
ADMIN_USERNAME=rnpnt
# Generate with: node scripts/hash-password.js "your password"
ADMIN_PASSWORD_HASH=$2b$12$...

# Runnin' Point's Stripe Connect platform secret
STRIPE_SECRET_KEY=sk_test_...
# Connect webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# NEQO Digital legacy client integration. Use the same token in NEQO Digital as
# RUNNIN_POINT_INTEGRATION_TOKEN; keep both values private.
NEQO_BRIDGE_URL=https://www.neqodigital.com
NEQO_RUNNIN_POINT_TOKEN=replace-with-a-long-random-secret

# Automatically supplied when Vercel Blob is attached to the project
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Canonical production URL, without a trailing slash
SITE_URL=https://runnin-point.vercel.app

